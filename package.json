{
  "name": "cartrace",
  "version": "1.0.0",
  "description": "Blockchain-powered vehicle history platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "chain": "npx hardhat node",
    "deploy": "npx hardhat run scripts/deploy.js --network ganache",
